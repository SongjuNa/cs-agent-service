# 이 파일을 .env로 복사한 뒤 값을 채운다. .env는 커밋하지 않는다(CLAUDE.md 규칙 8).

# DB 컨테이너
POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cs_agent

# api 서버와 시험이 DB에 접속하는 주소 (기술 명세서 §1-5)
# 컨테이너 밖(내 컴퓨터)에서 시험할 때는 localhost, api 컨테이너 안에서는 docker-compose.yml이 db로 바꿔 쓴다
DATABASE_URL=postgresql://cs:change-me@localhost:5432/cs_agent

# 운영진 데이터 폴더 (커밋하지 않는다, CLAUDE.md 규칙 8). 저장소 루트 기준 경로
DATA_DIR=data/CS_AI_Agent_Training_Data_v1

# 언어 모델 키와 소형 등급 모델 이름 (기술 명세서 §1-5, §3-5)
GEMINI_API_KEY=
LLM_MODEL_SMALL=gemini-3.8-flash
EMBEDDING_MODEL=gemini-embedding-2

# 5분 주기 점검(SLA 경고, 무응답 종료). 끄려면 false (기술 명세서 §6-4)
# SCHEDULER_ENABLED=true
